                ])
              )
            )
          )
        );
      allow delete: if isValidId(userId) && (hasServerWriteGate('usr_' + userId) || (isAdmin() && !('vaultKey' in existing())));

      // Isolated PII Subcollection
      match /private/{docId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(docId) &&
          !('vaultKey' in existing()) && (request.auth.uid == userId || isAdmin());
        allow list: if hasServerVaultRead();
        allow create: if isValidId(userId) && isValidId(docId) && isValidUserPrivate(incoming()) &&
          incoming().uid == userId && incoming().updatedAt == request.time &&
          (exists(/databases/$(database)/documents/users/$(userId)) || existsAfter(/databases/$(database)/documents/users/$(userId))) && (
            hasServerWriteGate('usrpriv_' + userId + '_' + docId) ||
            (isVerifiedUser() && !('vaultKey' in incoming()) && (request.auth.uid == userId || isAdmin()))
          );
        allow update: if isValidId(userId) && isValidId(docId) && isValidUserPrivate(incoming()) &&
          incoming().uid == existing().uid && incoming().updatedAt == request.time && (
            hasServerWriteGate('usrpriv_' + userId + '_' + docId) ||
            (
              isVerifiedUser() && !('vaultKey' in existing()) && !('vaultKey' in incoming()) && (
                isAdmin() ||
                (
                  request.auth.uid == userId &&
                  exists(/databases/$(database)/documents/users/$(userId)) &&
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'email', 'phone', 'defaultCounty', 'defaultTown', 'defaultStreetAddress', 'updatedAt'
                  ])
                )
              )
            )
          );
        allow delete: if isValidId(userId) && isValidId(docId) &&
          (hasServerWriteGate('usrpriv_' + userId + '_' + docId) || (isAdmin() && !('vaultKey' in existing())));
      }

      // Saved Delivery Addresses Subcollection
      match /addresses/{addressId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(addressId) && !('vaultKey' in existing()) && (
          (request.auth.uid == userId && exists(/databases/$(database)/documents/users/$(userId))) ||
          isAdmin()
        );
        allow list: if (isSignedIn() && !('vaultKey' in existing()) && (
          (request.auth.uid == userId && existing().uid == request.auth.uid) ||
          isBootstrappedAdmin()
        )) || hasServerVaultRead();
        allow create: if isValidId(userId) && isValidId(addressId) && isValidDeliveryAddress(incoming()) &&
          incoming().uid == userId &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId)) && (
            hasServerWriteGate('usraddr_' + addressId) ||
            (isVerifiedUser() && !('vaultKey' in incoming()) && request.auth.uid == userId)
          );
        allow update: if isValidId(userId) && isValidId(addressId) && isValidDeliveryAddress(incoming()) &&
          incoming().uid == existing().uid && incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            hasServerWriteGate('usraddr_' + addressId) ||
            (
              isVerifiedUser() && !('vaultKey' in existing()) && !('vaultKey' in incoming()) && (
                isAdmin() ||
                (
                  request.auth.uid == userId &&
                  exists(/databases/$(database)/documents/users/$(userId)) &&
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'label', 'recipientName', 'phone', 'county', 'town', 'streetDetails', 'isDefault', 'updatedAt'
                  ])
                )
              )
            )
          );
        allow delete: if isValidId(userId) && isValidId(addressId) && (
          hasServerWriteGate('usraddr_' + addressId) ||
          (
            isVerifiedUser() && !('vaultKey' in existing()) && (
              (request.auth.uid == userId && exists(/databases/$(database)/documents/users/$(userId))) ||
              isAdmin()
            )
          )
        );
      }
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && !('vaultKey' in existing()) &&
        (existing().customerId == request.auth.uid || isAdmin());
      allow list: if (isSignedIn() && !('vaultKey' in existing()) && (existing().customerId == request.auth.uid || isBootstrappedAdmin())) ||
        hasServerVaultRead();
      allow create: if isValidId(orderId) && isValidOrder(incoming()) &&
        incoming().paymentStatus == 'pending_verification' &&
        incoming().orderStatus == 'pending' &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time && (
          hasServerWriteGate('ord_' + orderId) ||
          (
            isVerifiedUser() && !('vaultKey' in incoming()) &&
            incoming().customerId == request.auth.uid &&
            (
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
              existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
            )
          )
        );
      allow update: if isValidId(orderId) && isValidOrder(incoming()) &&
        incoming().customerId == existing().customerId &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          hasServerWriteGate('ord_' + orderId) ||
          (
            isVerifiedUser() && !('vaultKey' in existing()) && !('vaultKey' in incoming()) && (
              isAdmin() ||
              (
                existing().customerId == request.auth.uid &&
                existing().orderStatus != 'delivered' &&
                existing().orderStatus != 'cancelled' &&
                (
                  // Action 1: Customer cancels a pending order
                  (
                    existing().orderStatus == 'pending' &&
                    incoming().orderStatus == 'cancelled' &&
                    incoming().paymentStatus == existing().paymentStatus &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus', 'updatedAt'])
                  ) ||
                  // Action 2: Customer submits payment transaction reference for admin verification
                  (
                    existing().paymentStatus == 'pending_verification' &&
                    incoming().paymentStatus == 'pending_verification' &&
                    incoming().orderStatus == existing().orderStatus &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['paymentReference', 'updatedAt'])
                  )
                )
              )
            )
          )
        );
      allow delete: if isValidId(orderId) && (hasServerWriteGate('ord_' + orderId) || (isAdmin() && !('vaultKey' in existing())));

      match /items/{itemId} {
        allow get: if isSignedIn() && isValidId(orderId) && isValidId(itemId) && !('vaultKey' in existing()) && (
          isAdmin() ||
          (
            existing().customerId == request.auth.uid &&
            get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid
          )
        );
        allow list: if (isSignedIn() && !('vaultKey' in existing()) && (existing().customerId == request.auth.uid || isBootstrappedAdmin())) ||
          hasServerVaultRead();
        allow create: if isValidId(orderId) && isValidId(itemId) && isValidOrderItem(incoming()) &&
          incoming().orderId == orderId &&
          incoming().createdAt == request.time && (
            (hasServerWriteGate('orditem_' + orderId + '_' + itemId) && exists(/databases/$(database)/documents/orders/$(orderId))) ||
            (
              isVerifiedUser() && !('vaultKey' in incoming()) &&
              incoming().customerId == request.auth.uid &&
              (
                (exists(/databases/$(database)/documents/orders/$(orderId)) && get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid) ||
                (existsAfter(/databases/$(database)/documents/orders/$(orderId)) && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid)
              )
            )
          );
        allow update: if isValidId(orderId) && isValidId(itemId) && isValidOrderItem(incoming()) &&
          incoming().orderId == existing().orderId && incoming().customerId == existing().customerId &&
          incoming().createdAt == existing().createdAt &&
          (hasServerWriteGate('orditem_' + orderId + '_' + itemId) || (isVerifiedUser() && !('vaultKey' in existing()) && !('vaultKey' in incoming()) && isAdmin()));
        allow delete: if isValidId(orderId) && isValidId(itemId) &&
          (hasServerWriteGate('orditem_' + orderId + '_' + itemId) || (isAdmin() && !('vaultKey' in existing())));
      }
    }

    match /quotations/{quotationId} {
      allow get: if isSignedIn() && isValidId(quotationId) && !('vaultKey' in existing()) &&
        (existing().customerId == request.auth.uid || isAdmin());
      allow list: if (isSignedIn() && !('vaultKey' in existing()) && (existing().customerId == request.auth.uid || isBootstrappedAdmin())) ||
        hasServerVaultRead();
      allow create: if isValidId(quotationId) && isValidQuotation(incoming()) &&
        incoming().status == 'submitted' &&
        incoming().quotedTotalKes == 0 &&
        incoming().adminResponseNotes == '' &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time && (
          hasServerWriteGate('qt_' + quotationId) ||
          (isVerifiedUser() && !('vaultKey' in incoming()) && incoming().customerId == request.auth.uid)
