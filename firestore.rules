        allow list: if (isSignedIn() && !('vaultKey' in existing()) && (existing().customerId == request.auth.uid || isBootstrappedAdmin())) ||
          hasServerVaultRead();
        allow create: if isValidId(quotationId) && isValidId(itemId) && isValidQuotationItem(incoming()) &&
          incoming().quotationId == quotationId &&
