      allow delete: if isValidId(quotationId) && (hasServerWriteGate('qt_' + quotationId) || (isAdmin() && !('vaultKey' in existing())));

      match /items/{itemId} {
        allow get: if isSignedIn() && isValidId(quotationId) && isValidId(itemId) && !('vaultKey' in existing()) && (
