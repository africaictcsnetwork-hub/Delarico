        allow update: if isValidId(quotationId) && isValidId(itemId) && isValidQuotationItem(incoming()) &&
          incoming().quotationId == existing().quotationId && incoming().customerId == existing().customerId &&
          incoming().createdAt == existing().createdAt &&
          (hasServerWriteGate('qtitem_' + quotationId + '_' + itemId) || (isVerifiedUser() && !('vaultKey' in existing()) && !('vaultKey' in incoming()) && isAdmin()));
        allow delete: if isValidId(quotationId) && isValidId(itemId) &&
