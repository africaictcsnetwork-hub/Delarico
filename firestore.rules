    match /enquiries/{enquiryId} {
      allow get: if isSignedIn() && isValidId(enquiryId) && !('vaultKey' in existing()) &&
        (existing().customerId == request.auth.uid || isAdmin());
      allow list: if (isSignedIn() && !('vaultKey' in existing()) && (existing().customerId == request.auth.uid || isBootstrappedAdmin())) ||
        hasServerVaultRead();
      allow create: if isValidId(enquiryId) && isValidEnquiry(incoming()) &&
