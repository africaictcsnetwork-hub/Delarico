        incoming().adminReply == '' &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time && (
          hasServerWriteGate('enq_' + enquiryId) ||
          (isVerifiedUser() && !('vaultKey' in incoming()) && incoming().customerId == request.auth.uid)
        );
      allow update: if isValidId(enquiryId) && isValidEnquiry(incoming()) &&
        incoming().customerId == existing().customerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (hasServerWriteGate('enq_' + enquiryId) || (isVerifiedUser() && !('vaultKey' in existing()) && !('vaultKey' in incoming()) && isAdmin()));
      allow delete: if isValidId(enquiryId) && (hasServerWriteGate('enq_' + enquiryId) || (isAdmin() && !('vaultKey' in existing())));
    }

    match /promotions/{promotionId} {
      allow get: if isValidId(promotionId) && (existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isBootstrappedAdmin();
      allow create: if isValidId(promotionId) && isValidPromotion(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        (hasServerWriteGate('promo_' + promotionId) || (isVerifiedUser() && isAdmin()));
      allow update: if isValidId(promotionId) && isValidPromotion(incoming()) &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        (hasServerWriteGate('promo_' + promotionId) || (isVerifiedUser() && isAdmin()));
      allow delete: if isValidId(promotionId) && (hasServerWriteGate('promo_' + promotionId) || isAdmin());
    }

    match /stockMovements/{movementId} {
      allow get: if isAdmin() && isValidId(movementId) && !('vaultKey' in existing());
      allow list: if (isBootstrappedAdmin() && !('vaultKey' in existing()) && existing().productId is string) ||
        hasServerVaultRead();
      allow create: if isValidId(movementId) && isValidStockMovement(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/products/$(incoming().productId)) && (
          hasServerWriteGate('stk_' + movementId) ||
          (isVerifiedUser() && !('vaultKey' in incoming()) && incoming().performedByUid == request.auth.uid && isAdmin())
        );
      allow update: if false;
      allow delete: if isValidId(movementId) && (hasServerWriteGate('stk_' + movementId) || (isAdmin() && !('vaultKey' in existing())));
    }

    match /branches/{branchId} {
      allow get: if isValidId(branchId) && (existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isBootstrappedAdmin();
      allow create: if isValidId(branchId) && isValidBranch(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        (hasServerWriteGate('branch_' + branchId) || (isVerifiedUser() && isAdmin()));
      allow update: if isValidId(branchId) && isValidBranch(incoming()) &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        (hasServerWriteGate('branch_' + branchId) || (isVerifiedUser() && isAdmin()));
      allow delete: if isValidId(branchId) && (hasServerWriteGate('branch_' + branchId) || isAdmin());
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && (existing().isPublic == true || isAdmin());
      allow list: if existing().isPublic == true || isBootstrappedAdmin();
      allow create: if isValidId(settingId) && isValidStoreSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        (hasServerWriteGate('set_' + settingId) || (isVerifiedUser() && isAdmin()));
      allow update: if isValidId(settingId) && isValidStoreSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        (hasServerWriteGate('set_' + settingId) || (isVerifiedUser() && isAdmin()));
      allow delete: if isValidId(settingId) && (hasServerWriteGate('set_' + settingId) || isAdmin());
    }

    match /affiliates/{affiliateId} {
      allow get: if isSignedIn() && isValidId(affiliateId) && !('vaultKey' in existing()) &&
        (request.auth.uid == affiliateId || isAdmin());
      allow list: if (isSignedIn() && !('vaultKey' in existing()) && (existing().uid == request.auth.uid || isBootstrappedAdmin())) ||
        hasServerVaultRead();
      allow create: if isValidId(affiliateId) && isValidAffiliateProfile(incoming()) &&
        incoming().uid == affiliateId &&
        incoming().totalClicks == 0 &&
        incoming().totalReferrals == 0 &&
        incoming().totalSalesKes == 0 &&
        incoming().pendingCommissionKes == 0 &&
        incoming().availableCommissionKes == 0 &&
        incoming().paidCommissionKes == 0 &&
        incoming().payoutRequested == false &&
        incoming().status == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          exists(/databases/$(database)/documents/users/$(affiliateId)) ||
          existsAfter(/databases/$(database)/documents/users/$(affiliateId))
        ) && (
          hasServerWriteGate('aff_' + affiliateId) ||
          (isVerifiedUser() && !('vaultKey' in incoming()) && request.auth.uid == affiliateId)
        );
      allow update: if isValidId(affiliateId) && isValidAffiliateProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().affiliateCode == existing().affiliateCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          hasServerWriteGate('aff_' + affiliateId) ||
          (
            isVerifiedUser() && !('vaultKey' in existing()) && !('vaultKey' in incoming()) && (
              isAdmin() ||
              (
                request.auth.uid == affiliateId &&
                existing().status == 'active' &&
                incoming().status == existing().status &&
                incoming().commissionRatePct == existing().commissionRatePct &&
                incoming().totalClicks == existing().totalClicks &&
                incoming().totalReferrals == existing().totalReferrals &&
                incoming().totalSalesKes == existing().totalSalesKes &&
                incoming().pendingCommissionKes == existing().pendingCommissionKes &&
                incoming().availableCommissionKes == existing().availableCommissionKes &&
                incoming().paidCommissionKes == existing().paidCommissionKes &&
                incoming().diff(existing()).affectedKeys().hasOnly(['mpesaPhone', 'payoutRequested', 'updatedAt'])
              )
            )
          )
        );
      allow delete: if isValidId(affiliateId) && (hasServerWriteGate('aff_' + affiliateId) || (isAdmin() && !('vaultKey' in existing())));
    }

    match /affiliateReferrals/{referralId} {
      allow get: if isSignedIn() && isValidId(referralId) && !('vaultKey' in existing()) &&
        (existing().affiliateUid == request.auth.uid || isAdmin());
      allow list: if (isSignedIn() && !('vaultKey' in existing()) && (existing().affiliateUid == request.auth.uid || isBootstrappedAdmin())) ||
        hasServerVaultRead();
      allow create: if isValidId(referralId) && isValidAffiliateReferral(incoming()) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/affiliates/$(incoming().affiliateUid)) &&
        exists(/databases/$(database)/documents/orders/$(incoming().orderId)) &&
        hasServerWriteGate('affref_' + referralId);
      allow update: if isValidId(referralId) && isValidAffiliateReferral(incoming()) &&
        incoming().affiliateUid == existing().affiliateUid &&
        incoming().affiliateCode == existing().affiliateCode &&
        incoming().orderId == existing().orderId &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().status != 'paid' &&
        existing().status != 'cancelled' && (
          hasServerWriteGate('affref_' + referralId) ||
          (isVerifiedUser() && !('vaultKey' in existing()) && !('vaultKey' in incoming()) && isAdmin())
        );
      allow delete: if isValidId(referralId) && (hasServerWriteGate('affref_' + referralId) || (isAdmin() && !('vaultKey' in existing())));
    }

    match /newsletterSubscribers/{subscriberId} {
      allow get: if isAdmin() && isValidId(subscriberId) && !('vaultKey' in existing());
      allow list: if (isBootstrappedAdmin() && !('vaultKey' in existing()) && existing().email is string) ||
        hasServerVaultRead();
      allow create: if isValidId(subscriberId) && isValidNewsletterSubscriber(incoming()) &&
        incoming().consentAccepted == true &&
        incoming().status == 'subscribed' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        hasServerWriteGate('news_' + subscriberId);
      allow update: if isValidId(subscriberId) && isValidNewsletterSubscriber(incoming()) &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          hasServerWriteGate('news_' + subscriberId) ||
          (isVerifiedUser() && !('vaultKey' in existing()) && !('vaultKey' in incoming()) && isAdmin())
        );
      allow delete: if isValidId(subscriberId) && (
        hasServerWriteGate('news_' + subscriberId) ||
        (isAdmin() && !('vaultKey' in existing()))
      );
    }
  }
}
