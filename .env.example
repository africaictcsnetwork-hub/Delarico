# Production Environment Variables
# Copy this file to .env on your backend server and fill in real values (never commit .env).

# Port the Node.js server listens on (HostAfrica cPanel Passenger injects PORT automatically; VPS uses 3000)
PORT=3000

# Set to production when deployed
NODE_ENV=production

# Required for AI Customer Service Chatbot (/api/ai/chat)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Recommended: random 32+ char string for signing customer & admin session tokens
SESSION_SECRET="CHANGE_TO_A_LONG_RANDOM_SECRET_KEY"

# Public domain URL where the store is hosted
APP_URL="https://delarico.co.ke"

# Optional comma-separated extra CORS origins if hosting API separately from delarico.co.ke
# ALLOWED_ORIGINS="https://delarico.co.ke,https://www.delarico.co.ke"

# Optional external API origin for static-only Vite builds (leave empty for same-origin /api)
# VITE_API_BASE_URL="https://api.delarico.co.ke"
